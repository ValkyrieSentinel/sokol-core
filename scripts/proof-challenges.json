      "replace": {
        "before": "start != 0 || *previous == [0; CHAIN_LEN]",
        "after": "start != 0 || *previous != [0; CHAIN_LEN]"
      },
      "assertion": "assertion failed: accepted == previous == [0; CHAIN_LEN]"
    },
    {
